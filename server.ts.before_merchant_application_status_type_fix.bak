                data.reference ??
                  data.transferReference ??
                  data.bankReference,
              ) || null,

            createdAt:
              data.createdAt ?? null,

            updatedAt:
              data.updatedAt ?? null,
          };
        })
        .sort((a, b) => {
          const aTime =
            a.requestedAt?.toMillis?.() ??
            a.createdAt?.toMillis?.() ??
            (a.requestedAt
              ? new Date(a.requestedAt).getTime()
              : 0);

          const bTime =
            b.requestedAt?.toMillis?.() ??
            b.createdAt?.toMillis?.() ??
            (b.requestedAt
              ? new Date(b.requestedAt).getTime()
              : 0);

          return bTime - aTime;
        })
        .slice(0, limit);

      return res.json({
        success: true,

        merchant: {
          merchantId: merchant.merchantId,
          uid: merchant.uid,
          name: text(
            merchant.merchantData.name ??
              merchant.merchantData.businessName ??
