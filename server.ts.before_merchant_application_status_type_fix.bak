// CUSTOMER - PENDING CUSTOMER SERVICE VERIFICATION
// ============================================================

app.get(
  "/customer/customer-service/verification/pending",
  async (req, res) => {
    try {
      const authenticated = await verifyCustomer(req);

      const customerIds = Array.from(
        authenticated.customer.ids,
      );

      if (customerIds.length === 0) {
        return res.status(404).json({
          success: false,
          pending: false,
          message: "Customer profile was not found.",
        });
      }

      const sessions = new Map<
        string,
        DocumentData & { id: string }
      >();

      for (const customerId of customerIds) {
        const snapshot = await db
          .collection("customer_service_verifications")
          .where("customerId", "==", customerId)
          .where("status", "==", "pending")
          .limit(20)
          .get();

        for (const doc of snapshot.docs) {
          sessions.set(doc.id, {
            id: doc.id,
            ...(doc.data() ?? {}),
          });
        }
      }

      const now = Date.now();

      const pending = Array.from(sessions.values())
        .filter((verification) => {
          const expiresAt = verification.expiresAt;

          let expiresAtMs = 0;

          if (
            expiresAt &&
            typeof expiresAt.toMillis === "function"
          ) {
            expiresAtMs = expiresAt.toMillis();
          } else if (
            expiresAt &&
            typeof expiresAt.seconds === "number"
          ) {
            expiresAtMs =
              expiresAt.seconds * 1000;
          }

          return (
            !expiresAtMs ||
            expiresAtMs > now
          );
        })
        .sort((a, b) => {
          const aTime =
            a.createdAt?.toMillis?.() ?? 0;
          const bTime =
            b.createdAt?.toMillis?.() ?? 0;

          return bTime - aTime;
        });

      if (pending.length === 0) {
        return res.status(200).json({
          success: true,
          pending: false,
          verification: null,
        });
      }

      const verification = pending[0];

      return res.status(200).json({
        success: true,
        pending: true,
        verification: {
          verificationId: verification.id,
          customerId: text(
            verification.customerId,
          ),
          status: text(
            verification.status,
          ),
          expiresAt:
            verification.expiresAt ?? null,
          createdAt:
            verification.createdAt ?? null,
          staffEmail:
            text(verification.staffEmail),
          message:
            "Customer Service is requesting permission to view your protected MobiFlex account information.",
        },
      });
    } catch (error: any) {
      return res.status(401).json({
        success: false,
        pending: false,
        message:
          error?.message ??
          "Unable to check customer verification request.",
      });
    }
  },
);
// ============================================================
// CUSTOMER SERVICE VERIFICATION SESSION
// ============================================================

const CUSTOMER_SERVICE_VERIFICATION_TTL_MS =
  5 * 60 * 1000;

function generateCustomerServiceVerificationId(): string {
  return crypto.randomBytes(24).toString("hex");
}

function generateCustomerServiceChallenge(): string {
  return crypto.randomBytes(16).toString("hex");
}
async function verifyStaff(
  req: Request,
  allowedRoles = [
    "super admin",
    "superadmin",
    "super administrator",
    "manager",
    "agent",
    "sr",
    "finance",
  ],
): Promise<{
  uid: string;
  email: string;
  userData: DocumentData;
}> {
  const decoded = await verifyBearerToken(req);
  const snap = await db.collection("users").doc(decoded.uid).get();
  if (!snap.exists) throw new Error("User profile was not found.");

  const userData = snap.data() ?? {};
  const role = normalizeRole(userData.role ?? userData.accountType);
  const normalizedAllowed = allowedRoles.map(normalizeRole);

  if (!normalizedAllowed.includes(role)) {
    throw new Error("You are not authorized to perform this action.");
  }

  const status = text(
    userData.status ?? userData.accountStatus ?? "active",
  ).toLowerCase();
  if (["disabled", "blocked", "inactive", "suspended", "rejected"].includes(status)) {
    throw new Error("User account is not active.");
  }

  return {
    uid: decoded.uid,
    email: decoded.email || text(userData.email),
    userData,
  };
}

async function verifyMerchant(req: Request): Promise<{
  uid: string;
  email: string;
  userData: DocumentData;
  merchantId: string;
  merchantData: DocumentData;
}> {
  const decoded = await verifyBearerToken(req);

  const userSnap = await db
    .collection("users")
    .doc(decoded.uid)
    .get();

  if (!userSnap.exists) {
    throw new Error("User profile was not found.");
  }

  const userData = userSnap.data() ?? {};
  const role = normalizeRole(
    userData.role ?? userData.accountType,
  );

  if (role !== "merchant") {
    throw new Error(
      "Authenticated account is not a merchant account.",
    );
  }

  const status = text(
    userData.status ??
      userData.accountStatus ??
      "active",
  ).toLowerCase();

  if (
    [
      "disabled",
      "blocked",
      "inactive",
      "suspended",
      "rejected",
    ].includes(status)
  ) {
    throw new Error("Merchant account is not active.");
  }

  const merchantId = text(
    userData.merchantId ??
      userData.merchantID ??
      userData.merchant_id,
  );

  if (!merchantId) {
    throw new Error(
      "Merchant account is not linked to a merchant profile.",
    );
  }

  const merchantSnap = await db
    .collection("merchants")
    .doc(merchantId)
    .get();

  if (!merchantSnap.exists) {
    throw new Error("Merchant profile was not found.");
  }

  const merchantData = merchantSnap.data() ?? {};

  return {
    uid: decoded.uid,
    email:
      decoded.email ||
      text(userData.email),
    userData,
    merchantId,
    merchantData,
  };
}

app.get(
  "/merchant/wallet",
  async (req: Request, res: Response) => {
    try {
      const merchant = await verifyMerchant(req);
      const data = merchant.merchantData;

      const pendingBalance = money(
        data.pendingBalance ??
          data.merchantPendingBalance ??
          0,
      );

      const merchantPendingBalance = money(
        data.merchantPendingBalance ??
          data.pendingBalance ??
          0,
      );

      const availableBalance = money(
        data.availableBalance ??
          data.merchantAvailableBalance ??
          0,
      );

      const reservedBalance = money(
        data.reservedBalance ??
          data.merchantReservedBalance ??
          0,
      );

      const settledBalance = money(
        data.settledBalance ??
          data.merchantSettledBalance ??
          0,
      );

      const withdrawnBalance = money(
        data.withdrawnBalance ??
          data.merchantWithdrawnBalance ??
          0,
      );

      const totalGrossPayments = money(
        data.totalGrossPayments ?? 0,
      );

      const totalProviderFees = money(
        data.totalProviderFees ?? 0,
      );

      const totalMerchantFees = money(
        data.totalMerchantFees ?? 0,
      );

      const totalMerchantNetAmount = money(
        data.totalMerchantNetAmount ?? 0,
      );

      const totalMobiFlexRevenue = money(
        data.totalMobiFlexRevenue ?? 0,
      );

      return res.json({
        success: true,
        merchant: {
          merchantId: merchant.merchantId,
          uid: merchant.uid,
          name: text(
            data.name ??
              data.businessName ??
              data.merchantName,
          ),
          country: normalizeCountry(
            data.country ??
              data.countryCode ??
              merchant.userData.country ??
              "MW",
          ),
          currency: normalizeCurrency(
            data.currency ??
              data.currencyCode ??
              merchant.userData.currency ??
              "MWK",
          ),
        },
        wallet: {
          pendingBalance,
          merchantPendingBalance,
          availableBalance,
          reservedBalance,
          settledBalance,
          withdrawnBalance,
        },
        totals: {
          totalGrossPayments,
          totalProviderFees,
          totalMerchantFees,
          totalMerchantNetAmount,
          totalMobiFlexRevenue,
        },
        lastPaymentTransactionId:
          text(data.lastPaymentTransactionId) ||
          null,
        lastPaymentAt:
          data.lastPaymentAt ?? null,
        updatedAt:
          data.updatedAt ?? null,
      });
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "Unable to load merchant wallet.";

      const lowerMessage = message.toLowerCase();

      const statusCode =
        lowerMessage.includes("authorized") ||
        lowerMessage.includes("merchant account")
          ? 403
          : lowerMessage.includes("bearer") ||
              lowerMessage.includes("token")
            ? 401
            : 400;

      return res.status(statusCode).json({
        success: false,
        error: message,
      });
    }
  },
);

app.get(
  "/merchant/ledger",
  async (req: Request, res: Response) => {
    try {
      const merchant = await verifyMerchant(req);

      const limitRaw = Number(req.query.limit ?? 100);
      const limit = Math.min(
        Math.max(Number.isFinite(limitRaw) ? Math.floor(limitRaw) : 100, 1),
        200,
      );

      const snapshot = await db
        .collection("merchant_payment_transactions")
        .where("merchantId", "==", merchant.merchantId)
        .get();

      const transactions = snapshot.docs
        .map((doc) => {
          const data = doc.data();

          return {
            transactionId: text(
              data.transactionId ?? doc.id,
            ),
            paymentId: text(data.paymentId) || null,
            merchantId: text(
              data.merchantId ?? merchant.merchantId,
            ),
            customerId:
              text(data.customerId ?? data.customerUid) || null,
            applicationId:
              text(data.applicationId) || null,
            country:
              normalizeCountry(
                data.country ??
                  merchant.merchantData.country ??
                  merchant.userData.country ??
                  "MW",
              ),
            currency:
              normalizeCurrency(
                data.currency ??
                  merchant.merchantData.currency ??
                  merchant.userData.currency ??
                  "MWK",
              ),
            grossAmount: money(
              data.grossAmount ?? 0,
            ),
            providerFee: money(
              data.providerFee ?? 0,
            ),
            merchantFee: money(
              data.merchantFee ?? 0,
            ),
            mobiFlexRevenue: money(
              data.mobiFlexRevenue ?? 0,
            ),
            merchantNetAmount: money(
              data.merchantNetAmount ?? 0,
            ),
            settlementStatus:
              text(data.settlementStatus) ||
              "Pending",
            settlementId:
              text(data.settlementId) || null,
            provider:
              text(data.provider) || null,
            chargeId:
              text(data.chargeId) || null,
            providerChargeId:
              text(data.providerChargeId) || null,
            providerReference:
              text(data.providerReference) || null,
            createdAt:
              data.createdAt ?? null,
            updatedAt:
              data.updatedAt ?? null,
          };
        })
        .sort((a, b) => {
          const aTime =
            a.createdAt?.toMillis?.() ??
            (a.createdAt
              ? new Date(a.createdAt).getTime()
              : 0);

          const bTime =
            b.createdAt?.toMillis?.() ??
            (b.createdAt
              ? new Date(b.createdAt).getTime()
              : 0);

          return bTime - aTime;
        })
        .slice(0, limit);

      return res.json({
        success: true,
        merchant: {
          merchantId: merchant.merchantId,
          uid: merchant.uid,
          name: text(
            merchant.merchantData.name ??
              merchant.merchantData.businessName ??
              merchant.merchantData.merchantName,
          ),
          country: normalizeCountry(
            merchant.merchantData.country ??
              merchant.merchantData.countryCode ??
              merchant.userData.country ??
              "MW",
          ),
          currency: normalizeCurrency(
            merchant.merchantData.currency ??
              merchant.merchantData.currencyCode ??
              merchant.userData.currency ??
              "MWK",
          ),
        },
        count: transactions.length,
        transactions,
      });
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "Unable to load merchant ledger.";

      const lowerMessage = message.toLowerCase();

      const statusCode =
        lowerMessage.includes("authorized") ||
        lowerMessage.includes("merchant account")
          ? 403
          : lowerMessage.includes("bearer") ||
              lowerMessage.includes("token")
            ? 401
            : 400;

      return res.status(statusCode).json({
        success: false,
        error: message,
      });
    }
  },
);


app.get(
  "/merchant/settlements",
  async (req: Request, res: Response) => {
    try {
      const merchant = await verifyMerchant(req);

      const limitRaw = Number(req.query.limit ?? 100);
      const limit = Math.min(
        Math.max(
          Number.isFinite(limitRaw)
            ? Math.floor(limitRaw)
            : 100,
          1,
        ),
        200,
      );

      const snapshot = await db
        .collection("bank_settlements")
        .where("merchantId", "==", merchant.merchantId)
        .get();

      const settlements = snapshot.docs
        .map((doc) => {
          const data = doc.data();

          return {
            settlementId:
              text(data.settlementId ?? doc.id),

            merchantId:
              text(
                data.merchantId ??
                  merchant.merchantId,
              ),

            amount: money(
              data.amount ??
                data.settlementAmount ??
                data.netAmount ??
                0,
            ),

            currency:
              normalizeCurrency(
                data.currency ??
                  data.currencyCode ??
                  merchant.merchantData.currency ??
                  merchant.userData.currency ??
                  "MWK",
              ),

            country:
              normalizeCountry(
                data.country ??
                  data.countryCode ??
                  merchant.merchantData.country ??
                  merchant.userData.country ??
                  "MW",
              ),

            status:
              text(
                data.status ??
                  data.settlementStatus,
              ) || "Pending",

            bankName:
              text(data.bankName) || null,

            accountName:
              text(data.accountName) || null,

            accountNumber:
              text(data.accountNumber) || null,

            bankAccountId:
              text(data.bankAccountId) || null,

            requestedBy:
              text(data.requestedBy) || null,

            approvedBy:
              text(data.approvedBy) || null,

            requestedAt:
              data.requestedAt ??
              data.createdAt ??
              null,

            approvedAt:
              data.approvedAt ??
              null,

            processedAt:
              data.processedAt ??
              null,

            completedAt:
              data.completedAt ??
              null,

            rejectionReason:
              text(
                data.rejectionReason ??
                  data.reason,
              ) || null,

            reference:
