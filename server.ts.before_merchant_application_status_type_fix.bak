// ============================================================
// SUPER ADMIN - REAL MONEY MANAGER PAYROLL READINESS
// ============================================================
// Read-only endpoint. It NEVER creates a payout or moves money.
// ============================================================
// ============================================================
// SUPER ADMIN - REAL MONEY MANAGER PAYROLL READINESS
// ============================================================
// Read-only endpoint. It NEVER creates a payout or moves money.
// ============================================================
// ============================================================
// SUPER ADMIN - REAL MONEY MANAGER PAYROLL READINESS
// ============================================================
// Read-only endpoint. It NEVER creates a payout or moves money.
// ============================================================
app.get(
  "/admin/manager-payroll/real-money-readiness",
  async (req: Request, res: Response) => {
    try {
      const admin = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      const secretConfigured = !!text(
        process.env.PAYCHANGU_SECRET_KEY,
      );
      const webhookConfigured = !!text(
        process.env.PAYCHANGU_WEBHOOK_SECRET,
      );
      const paymentMode =
        text(process.env.PAYMENT_MODE) ||
        text(process.env.PAYCHANGU_MODE) ||
        "unknown";
      const liveOnly =
        paymentMode.toLowerCase() === "live-only" ||
        paymentMode.toLowerCase() === "live";

      let wallet = null;
      let walletCheckError = "";

      if (secretConfigured && liveOnly) {
        try {
          const currency = normalizeCurrency(
            text(req.query.currency) || "MWK",
          );
          const result = await getPayChanguWalletBalance(currency);
          wallet = {
            environment: result.environment,
            currency: result.currency || currency,
            mainBalance: result.mainBalance,
            collectionBalance: result.collectionBalance,
          };
        } catch (walletError) {
          walletCheckError =
            walletError instanceof Error
              ? walletError.message
              : String(walletError);
        }
      }

      return res.status(200).json({
        success: true,
        requestedBy: admin.uid,
        liveMoneyReady:
          secretConfigured && liveOnly && !walletCheckError,
        secretConfigured,
        webhookConfigured,
        paymentMode,
        wallet,
        walletCheckError: walletCheckError || null,
      });
    } catch (error) {
      const message =
        error instanceof Error ? error.message : String(error);
      const lowerMessage = message.toLowerCase();

      const statusCode =
        lowerMessage.includes("authorization token is required") ||
        lowerMessage.includes("authorization token is empty") ||
        lowerMessage.includes("invalid token") ||
        lowerMessage.includes("invalid signature") ||
        lowerMessage.includes("token has expired")
          ? 401
          : (
              lowerMessage.includes("not authorized") ||
              lowerMessage.includes("only super admin") ||
              lowerMessage.includes("account is not active") ||
              lowerMessage.includes("profile was not found")
            )
              ? 403
              : 500;

      return res.status(statusCode).json({
        success: false,
        error: message,
      });
    }
  },
);


// ============================================================
// MERCHANT ONBOARDING WORKFLOW
// ============================================================
//
// Merchant account creation is intentionally NOT part of the
// application submission step.
//
// Workflow:
//
// APPLICATION
//     -> MANAGER REVIEW
//     -> MANAGER AGREEMENT + SIGNATURE
//     -> SUPER ADMIN VERIFICATION
//     -> SUPER ADMIN APPROVAL
//     -> FIREBASE MERCHANT ACCOUNT CREATION
//     -> PASSWORD SETUP EMAIL
//     -> KYC
//     -> DASHBOARD
//
// ============================================================

function merchantApplicationStatus(value: unknown): string {
  return text(value).trim().toLowerCase();
}

function merchantApplicationEmail(data: DocumentData): string {
  return text(
    data.ownerEmail ??
      data.applicantEmail ??
      data.email,
  ).toLowerCase();
}

function merchantApplicationName(data: DocumentData): string {
  return text(
    data.businessName ??
      data.merchantName ??
      data.ownerName ??
      data.fullName ??
      "Merchant Applicant",
  );
}

/**
 * MANAGER - LIST MERCHANT APPLICATIONS
 *
 * Manager can see applications waiting for Manager review and
 * applications already processed by the Manager.
 */
app.get(
  "/manager/merchant-applications",
  async (req: Request, res: Response) => {
    try {
      const manager = await verifyStaff(req, ["manager"]);

      const limitRaw = Number(req.query.limit ?? 100);
      const limit = Math.min(
        Math.max(Number.isFinite(limitRaw) ? limitRaw : 100, 1),
        200,
      );

      const snapshot = await db
        .collection("merchant_applications")
        .limit(limit)
        .get();

      const applications = snapshot.docs
        .map((doc) => {
          const data = doc.data();

          return {
            applicationId: doc.id,
            ...data,
            ownerEmail: merchantApplicationEmail(data),
            merchantName: merchantApplicationName(data),
          };
        })
        .filter((item) => {
          const status = merchantApplicationStatus(
            item.status ??
              item.applicationStatus ??
              item.reviewStatus,
          );

          return [
            "",
            "pending",
            "pending manager review",
            "manager_review",
            "manager review",
            "returned to manager",
            "manager returned",
          ].includes(status);
        });

      return res.status(200).json({
        success: true,
        managerUid: manager.uid,
        applications,
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

/**
 * MANAGER - REVIEW MERCHANT APPLICATION
 *
 * action:
 *   RETURN
 *   APPROVE
 *
 * APPROVE requires:
 *   - agreement accepted
 *   - manager signature
 *   - review confirmation
 *
 * This DOES NOT create the merchant account.
 */
app.post(
  "/manager/merchant-applications/:applicationId/review",
  async (req: Request, res: Response) => {
    try {
      const manager = await verifyStaff(req, ["manager"]);

      const applicationId = text(req.params.applicationId);
      const action = text(req.body?.action).toUpperCase();

      if (!applicationId) {
        return res.status(400).json({
          success: false,
          error: "Application ID is required.",
        });
      }

      if (!["RETURN", "APPROVE"].includes(action)) {
        return res.status(400).json({
          success: false,
          error: "Action must be RETURN or APPROVE.",
        });
      }

      const ref = db
        .collection("merchant_applications")
        .doc(applicationId);

      const snap = await ref.get();

      if (!snap.exists) {
        return res.status(404).json({
          success: false,
          error: "Merchant application not found.",
        });
      }

      const data = snap.data() ?? {};

      const currentStatus = merchantApplicationStatus(
        data.status ??
          data.applicationStatus ??
          data.reviewStatus,
      );

      const allowedStatuses = [
        "",
        "pending",
        "pending manager review",
        "manager_review",
        "manager review",
        "returned to manager",
        "manager returned",
      ];

      if (!allowedStatuses.includes(currentStatus)) {
        return res.status(409).json({
          success: false,
          error:
            "This merchant application is not currently available for Manager review.",
          currentStatus,
        });
      }

      if (action === "RETURN") {
        const reason = text(req.body?.reason);

        if (!reason) {
          return res.status(400).json({
            success: false,
            error: "A return reason is required.",
          });
        }

        await ref.set(
          {
            status: "Returned to Applicant",
            applicationStatus: "Returned to Applicant",
            reviewStatus: "returned",
            managerReviewStatus: "returned",
            managerReviewReason: reason,
            managerReviewedBy: manager.uid,
            managerReviewedByEmail: manager.email,
            managerReviewedAt:
              FieldValue.serverTimestamp(),
            updatedAt:
              FieldValue.serverTimestamp(),
          },
          { merge: true },
        );

        return res.status(200).json({
          success: true,
          applicationId,
          status: "Returned to Applicant",
          message:
            "Merchant application returned for correction.",
        });
      }

      const agreementAccepted =
        req.body?.agreementAccepted === true;

      const signature = text(
        req.body?.managerSignature,
      );

      const reviewConfirmed =
        req.body?.reviewConfirmed === true;

      if (!agreementAccepted) {
        return res.status(400).json({
          success: false,
          error:
            "Manager must confirm that the Merchant agreement and review rules were read.",
        });
      }

      if (!signature) {
        return res.status(400).json({
          success: false,
          error:
            "Manager signature is required.",
        });
      }

      if (!reviewConfirmed) {
        return res.status(400).json({
          success: false,
          error:
            "Manager must confirm that the application information was verified.",
        });
      }

      const requiredFields = [
        "businessName",
        "ownerName",
        "ownerEmail",
        "country",
      ];

      const missingFields = requiredFields.filter(
        (field) => !text(data[field]),
      );

      if (missingFields.length > 0) {
        return res.status(409).json({
          success: false,
          error:
            "Merchant application cannot pass Manager review.",
          missingFields,
        });
      }

      await ref.set(
        {
          status: "Pending Super Admin Review",
          applicationStatus: "pending_super_admin_review",
          reviewStatus: "manager_verified",
          managerReviewStatus: "verified",
          managerReviewedBy: manager.uid,
          managerReviewedByEmail: manager.email,
          managerReviewedAt:
            FieldValue.serverTimestamp(),
          managerAgreementAccepted: true,
          managerAgreementVersion:
            text(
              req.body?.agreementVersion,
            ) || "merchant-agreement-v1",
          managerSignature: signature,
          managerSignatureType: "digital",
          managerReviewConfirmed: true,
          managerReviewVerificationStatus: "passed",
          submittedTo: "Super Admin",
          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      return res.status(200).json({
        success: true,
        applicationId,
        status: "Pending Super Admin Review",
        message:
          "Merchant application verified by Manager and submitted to Super Admin.",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

/**
 * SUPER ADMIN - LIST MERCHANT APPLICATIONS
 */
app.get(
  "/admin/merchant-applications",
  async (req: Request, res: Response) => {
    try {
      const admin = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      const limitRaw = Number(req.query.limit ?? 100);
      const limit = Math.min(
        Math.max(Number.isFinite(limitRaw) ? limitRaw : 100, 1),
        200,
      );

      const snapshot = await db
        .collection("merchant_applications")
        .limit(limit)
        .get();

      const applications = snapshot.docs.map((doc) => {
        const data = doc.data();

        return {
          applicationId: doc.id,
          ...data,
          ownerEmail:
            merchantApplicationEmail(data),
          merchantName:
            merchantApplicationName(data),
        };
      });

      return res.status(200).json({
        success: true,
        adminUid: admin.uid,
        applications,
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

/**
 * SUPER ADMIN - VERIFY MERCHANT APPLICATION
 *
 * This is a read/check stage.
 * It does NOT create an account.
 */
app.post(
  "/admin/merchant-applications/:applicationId/verify",
  async (req: Request, res: Response) => {
    try {
      const admin = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      const applicationId = text(req.params.applicationId);

      const ref = db
        .collection("merchant_applications")
        .doc(applicationId);

      const snap = await ref.get();

      if (!snap.exists) {
        return res.status(404).json({
          success: false,
          verified: false,
          error:
            "Merchant application not found.",
        });
      }

      const data = snap.data() ?? {};

      const checks = [
        {
          name: "Manager verification",
          passed:
            text(
              data.managerReviewStatus,
            ).toLowerCase() === "verified",
          message:
            "Manager verification must be completed.",
        },
        {
          name: "Manager signature",
          passed:
            text(data.managerSignature).length > 0,
          message:
            "Manager signature is missing.",
        },
        {
          name: "Manager agreement",
          passed:
            data.managerAgreementAccepted === true,
          message:
            "Manager agreement confirmation is missing.",
        },
        {
          name: "Business name",
          passed:
            text(data.businessName).length > 0,
          message:
            "Business name is missing.",
        },
        {
          name: "Owner name",
          passed:
            text(data.ownerName).length > 0,
          message:
            "Owner name is missing.",
        },
        {
          name: "Owner email",
          passed:
            merchantApplicationEmail(data).includes("@"),
          message:
            "Valid owner email is missing.",
        },
        {
          name: "Country",
          passed:
            text(data.country).length > 0,
          message:
            "Country is missing.",
        },
      ];

      const failedChecks = checks
        .filter((check) => !check.passed)
        .map((check) => check.message);

      const verified =
        failedChecks.length === 0;

      await ref.set(
        {
          superAdminVerificationStatus:
            verified ? "passed" : "failed",
          superAdminVerificationChecks:
            checks,
          superAdminVerificationErrors:
            failedChecks,
          superAdminVerifiedBy:
            admin.uid,
          superAdminVerifiedByEmail:
            admin.email,
          superAdminVerifiedAt:
            FieldValue.serverTimestamp(),
          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      return res.status(200).json({
        success: true,
        verified,
        applicationId,
        checks,
        errors: failedChecks,
        message: verified
          ? "Merchant application verification passed."
          : "Merchant application verification failed.",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        verified: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

/**
 * SUPER ADMIN - FINAL MERCHANT APPROVAL
 *
 * THIS is the only stage that creates the Merchant account.
 */
app.post(
  "/admin/merchant-applications/:applicationId/approve",
  async (req: Request, res: Response) => {
    let createdUid = "";

    try {
      const admin = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      const applicationId =
        text(req.params.applicationId);

      const ref = db
        .collection("merchant_applications")
        .doc(applicationId);

      const snap = await ref.get();

      if (!snap.exists) {
        return res.status(404).json({
          success: false,
          error:
            "Merchant application not found.",
        });
      }

      const data = snap.data() ?? {};

      const verificationStatus =
        text(
          data.superAdminVerificationStatus,
        ).toLowerCase();

      if (verificationStatus !== "passed") {
        return res.status(409).json({
          success: false,
          error:
            "Merchant application cannot be approved until Super Admin verification passes.",
        });
      }

      const managerSignature =
        text(data.managerSignature);

      if (!managerSignature) {
        return res.status(409).json({
          success: false,
          error:
            "Manager signature is missing.",
        });
      }

      const email =
        merchantApplicationEmail(data);

      const name =
        merchantApplicationName(data);

      const phone = text(
        data.ownerPhone ??
          data.phone ??
          data.businessPhone,
      );

      const country =
        text(data.country) || "Malawi";

      if (!email.includes("@")) {
        return res.status(400).json({
          success: false,
          error:
            "Merchant application does not contain a valid email.",
        });
      }

      // --------------------------------------------------------
      // Idempotency: do not create another Firebase account.
      // --------------------------------------------------------
      const existingAuth =
        await auth
          .getUserByEmail(email)
          .catch((error: any) => {
            if (
              error?.code ===
              "auth/user-not-found"
            ) {
              return null;
            }

            throw error;
          });

      if (existingAuth) {
        const existingMerchant =
          await db
            .collection("merchants")
            .doc(existingAuth.uid)
            .get();

        if (existingMerchant.exists) {
          await ref.set(
            {
              status: "Approved",
              applicationStatus: "approved",
              merchantApprovalStatus:
                "approved",
              merchantUid:
                existingAuth.uid,
              merchantId:
                existingAuth.uid,
              approvedBy: admin.uid,
              approvedByEmail: admin.email,
              approvedAt:
                FieldValue.serverTimestamp(),
              accountCreated: true,
              updatedAt:
                FieldValue.serverTimestamp(),
            },
            { merge: true },
          );

          return res.status(200).json({
            success: true,
            alreadyCreated: true,
            applicationId,
            merchantUid:
              existingAuth.uid,
            merchantId:
              existingAuth.uid,
            email,
            message:
              "Merchant was already created. Application synchronized successfully.",
          });
        }

        return res.status(409).json({
          success: false,
          error:
            "The application email already belongs to another Firebase account.",
        });
      }

      // --------------------------------------------------------
      // Create Firebase Auth account.
      // --------------------------------------------------------
      const firebaseUser =
        await auth.createUser({
          email,
          displayName: name,
          emailVerified: false,
          disabled: false,
        });

      createdUid = firebaseUser.uid;

      const merchantId =
        createdUid;

      const merchantData: Record<
        string,
        unknown
      > = {
        uid: createdUid,
        merchantId,
        merchantUid: createdUid,

        role: "merchant",
        accountType: "Merchant",

        name,
        fullName: name,
        merchantName:
          text(data.businessName) ||
          name,

        email,
        phone,

        country,
        countryCode:
          text(data.countryCode),
        currency:
          text(data.currency),

        accountStatus:
          "pending_kyc",
        status:
          "pending_kyc",

        merchantStatus:
          "approved",

        kycStatus:
          "pending",
        kycCompleted:
          false,
        kycApproved:
          false,
        verificationStatus:
          "pending",

        merchantApplicationId:
          applicationId,

        managerUid:
          text(data.managerReviewedBy),
        managerEmail:
          text(data.managerReviewedByEmail),

        managerSignature:
          managerSignature,
        managerAgreementVersion:
          text(
            data.managerAgreementVersion,
          ) ||
          "merchant-agreement-v1",

        approvedBy:
          admin.uid,
        approvedByEmail:
          admin.email,

        createdAt:
          FieldValue.serverTimestamp(),
        updatedAt:
          FieldValue.serverTimestamp(),

        pendingBalance: 0,
        availableBalance: 0,
        reservedBalance: 0,
        settledBalance: 0,
        withdrawnBalance: 0,

        merchantPendingBalance: 0,
        merchantAvailableBalance: 0,
        merchantReservedBalance: 0,
        merchantSettledBalance: 0,
        merchantWithdrawnBalance: 0,

        totalGrossPayments: 0,
        totalProviderFees: 0,
        totalMerchantFees: 0,
        totalMerchantNetAmount: 0,
        totalMobiFlexRevenue: 0,
      };

      const userData: Record<
        string,
        unknown
      > = {
        ...merchantData,
        role: "merchant",
        accountType: "Merchant",
        accountStatus:
          "pending_kyc",
        status:
          "pending_kyc",
        kycStatus:
          "pending",
        kycApproved:
          false,
        kycCompleted:
          false,
        createdBy:
          admin.uid,
        createdByEmail:
          admin.email,
      };

      const batch =
        db.batch();

      batch.set(
        db
          .collection("users")
          .doc(createdUid),
        userData,
      );

      batch.set(
        db
          .collection("merchants")
          .doc(merchantId),
        merchantData,
      );

      batch.set(
        ref,
        {
          status: "Approved",
          applicationStatus:
            "approved",
          merchantApprovalStatus:
            "approved",

          merchantUid:
            createdUid,
          merchantId,

          accountCreated:
            true,

          approvedBy:
            admin.uid,
          approvedByEmail:
            admin.email,
          approvedAt:
            FieldValue.serverTimestamp(),

          passwordSetupEmail:
            "pending",

          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      await batch.commit();

      // --------------------------------------------------------
      // Password setup email.
      // --------------------------------------------------------
      let passwordSetupEmailSent =
        false;

      let passwordSetupError = "";

      try {
        await sendPasswordSetupEmail(
          email,
          name,
          "Merchant",
        );

        passwordSetupEmailSent =
          true;
      } catch (mailError) {
        passwordSetupError =
          mailError instanceof Error
            ? mailError.message
            : String(mailError);

        console.error(
          "Merchant password setup email error:",
          mailError,
        );
      }

      await ref.set(
        {
          passwordSetupEmail:
            passwordSetupEmailSent
              ? "sent"
              : "failed",
          passwordSetupEmailSent,
          passwordSetupEmailError:
            passwordSetupError ||
            null,
          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      return res.status(201).json({
        success: true,
        applicationId,
        merchantUid:
          createdUid,
        merchantId,
        email,

        accountStatus:
          "pending_kyc",

        kycStatus:
          "pending",

        passwordSetupEmailSent,

        message:
          passwordSetupEmailSent
            ? "Merchant approved. Account created and password setup email sent."
            : "Merchant approved and account created, but password setup email could not be sent.",
      });
    } catch (error) {
      console.error(
        "Merchant final approval error:",
        error,
      );

      // If Auth was created but Firestore failed,
      // surface the UID so the issue can be reconciled.
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
        createdUid:
          createdUid || null,
      });
    }
  },
);
