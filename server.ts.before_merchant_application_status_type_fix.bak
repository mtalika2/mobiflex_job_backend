// ============================================================
// CHECKOUT - OPTIONAL PAYCHANGU HOSTED FLOW
// ============================================================

app.post(
  "/payments/real/checkout",
  async (req: Request, res: Response) => {
    try {
      const authenticated = await verifyCustomer(req);
      const applicationId = text(req.body?.applicationId);
      const amount = money(req.body?.amount);

      if (!applicationId || amount <= 0) {
        return res.status(400).json({
          success: false,
          error:
            "applicationId and a valid amount are required.",
        });
      }

      if (
        !PAYCHANGU_CHECKOUT_CALLBACK_URL ||
        !PAYCHANGU_CHECKOUT_RETURN_URL
      ) {
        return res.status(503).json({
          success: false,
          error:
            "PayChangu checkout callback/return URLs are not configured.",
        });
      }

      const application = await assertApplicationOwner(
        applicationId,
        authenticated.customer.ids,
      );

      const country = applicationCountry(application.data);
      const currency = applicationCurrency(application.data);

      if (country !== "MW" || currency !== "MWK") {
        return res.status(501).json({
          success: false,
          error:
            "Hosted checkout is not connected for this country/currency yet.",
        });
      }

      const remaining = outstandingAmount(application.data);
      if (amount > remaining + 0.0001) {
        return res.status(400).json({
          success: false,
          error: "Payment cannot exceed outstanding balance.",
          outstanding: remaining,
        });
      }

      const txRef = createTransactionId("MFC");
      const paymentRef = db
        .collection("real_payment_transactions")
        .doc();

      await paymentRef.set({
        paymentId: paymentRef.id,
        txRef,
        provider: "paychangu",
        paymentMethod: "checkout",
        customerUid: authenticated.uid,
        customerId: text(application.data.customerId),
        customerName: authenticated.customer.name,
        customerEmail:
          authenticated.email || authenticated.customer.email,
        applicationId,
        country,
        currency,
        amount,
        outstandingAtCreation: remaining,
        status: "pending",
        paymentSource: "CUSTOMER_APP_CHECKOUT",
        createdAt: FieldValue.serverTimestamp(),
        updatedAt: FieldValue.serverTimestamp(),
      });

      const result = await payChanguRequest("/payment", {
        method: "POST",
        body: {
          amount: amount.toFixed(2),
          currency: "MWK",
          tx_ref: txRef,
          first_name: firstName(authenticated.customer.name),
          last_name: lastName(authenticated.customer.name),
          email:
            authenticated.email || authenticated.customer.email,
          callback_url: PAYCHANGU_CHECKOUT_CALLBACK_URL,
          return_url: PAYCHANGU_CHECKOUT_RETURN_URL,
          meta: JSON.stringify({
            paymentId: paymentRef.id,
            applicationId,
          }),
          customization: {
            title: "MobiFlex African Financing Payment",
            description:
              `Financing payment for application ${applicationId}`,
          },
        },
      });

      if (!result.response.ok) {
        await paymentRef.set(
          {
            status: "failed",
            providerError: result.data,
            updatedAt: FieldValue.serverTimestamp(),
          },
          { merge: true },
        );
        throw new Error(
          `PayChangu checkout initialization failed with HTTP ${result.response.status}.`,
        );
      }

      await paymentRef.set(
        {
          providerResponse: result.data,
          providerStatus: providerStatus(result.data),
          updatedAt: FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      const checkoutUrl = text(
        result.data?.data?.checkout_url ??
          result.data?.data?.link ??
          result.data?.checkout_url ??
          result.data?.link,
      );

      return res.status(201).json({
        success: true,
        paymentId: paymentRef.id,
        merchantReference: txRef,
        checkoutUrl: checkoutUrl || null,
        amount,
        currency,
        country,
        provider: "paychangu",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

// ============================================================

// ============================================================
// MERCHANT - REAL PAYOUT PREFLIGHT
// ============================================================

app.get(
  "/merchant/settlements/:settlementId/payout/preflight",
  async (req: Request, res: Response) => {
    try {
      const merchant = await verifyMerchant(req);
      assertPayChanguConfigured();

      const settlementId = text(req.params.settlementId);

      if (!settlementId) {
        return res.status(400).json({
          success: false,
          error: "Settlement ID is required.",
        });
      }

      const settlementRef = db
        .collection("bank_settlements")
        .doc(settlementId);

      const settlementSnap = await settlementRef.get();

      if (!settlementSnap.exists) {
        return res.status(404).json({
          success: false,
          error: "Merchant settlement was not found.",
        });
      }

      const settlement = settlementSnap.data() ?? {};

      if (text(settlement.merchantId) !== merchant.merchantId) {
        return res.status(403).json({
          success: false,
          error: "You are not authorized to access this settlement.",
        });
      }

      const settlementStatus = text(
        settlement.status ?? settlement.settlementStatus,
      ).toLowerCase();

      if (settlementStatus !== "approved") {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            `Settlement must be Approved before payout. Current status: ${settlement.status ?? settlement.settlementStatus ?? "unknown"}.`,
        });
      }

      const merchantRef = db
        .collection("merchants")
        .doc(merchant.merchantId);

      const merchantSnap = await merchantRef.get();

      if (!merchantSnap.exists) {
        return res.status(404).json({
          success: false,
          error: "Merchant account was not found.",
        });
      }

      const merchantData: DocumentData = merchantSnap.data() ?? {};

      const payoutAccountStatus = text(
        merchantData.payoutAccountStatus ??
          merchantData.settlementAccountStatus ??
          merchantData.bankAccountStatus ??
          "",
      ).toUpperCase();

      const payoutVerified =
        merchantData.payoutAccountVerified === true ||
        merchantData.settlementAccountVerified === true ||
        merchantData.bankAccountVerified === true ||
        ["VERIFIED", "APPROVED", "ACTIVE"].includes(
          payoutAccountStatus,
        );

      if (!payoutVerified) {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            "Merchant payout account must be VERIFIED before real payout.",
        });
      }

      const currency = normalizeCurrency(
        settlement.currency ??
          merchantData.currency ??
          merchant.userData.currency ??
          "MWK",
      );

      if (currency !== "MWK") {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            "Live merchant payout is currently enabled only for MWK in this MobiFlex PayChangu integration.",
          currency,
        });
      }

      const amount = money(
        settlement.amount ??
          settlement.settlementAmount ??
          0,
      );

      if (amount <= 0) {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error: "Merchant settlement amount must be greater than zero.",
        });
      }

      const walletBalance =
        await getPayChanguWalletBalance(currency);

      if (
        walletBalance.environment &&
        walletBalance.environment.toLowerCase() !== "live"
      ) {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            `PayChangu wallet is not in live environment. Current environment: ${walletBalance.environment}.`,
        });
      }

      if (
        walletBalance.currency &&
        walletBalance.currency !== currency
      ) {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            `PayChangu wallet currency mismatch. Expected ${currency}, received ${walletBalance.currency}.`,
        });
      }

      if (walletBalance.mainBalance + 0.0001 < amount) {
        return res.status(409).json({
          success: false,
          preflightPassed: false,
          error:
            `Insufficient PayChangu main balance for merchant payout. Required: ${amount.toFixed(2)} ${currency}; available: ${walletBalance.mainBalance.toFixed(2)} ${currency}.`,
          requiredAmount: amount,
          availableProviderBalance: walletBalance.mainBalance,
          currency,
        });
      }

      const payoutMethod: string = text(
        merchantData.payoutMethod ??
          merchantData.settlementMethod ??
          merchantData.bankAccountMethod ??
          "bank_transfer",
      ).toLowerCase();

      return res.status(200).json({
        success: true,
        preflightPassed: true,
        settlementId,
        merchantId: merchant.merchantId,
        amount,
        currency,
        payoutMethod,
        provider: "paychangu",
        providerEnvironment: walletBalance.environment || "live",
        providerMainBalance: walletBalance.mainBalance,
        message:
          "Merchant payout preflight passed. No payout was submitted.",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        preflightPassed: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

// ============================================================
// MERCHANT - SUPER ADMIN REAL PAYOUT EXECUTION
// ============================================================

app.post(
  "/admin/merchant-settlements/:settlementId/payout",
  async (req: Request, res: Response) => {
    try {
      const adminUser = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      assertPayChanguConfigured();

      const settlementId = text(req.params.settlementId);

      if (!settlementId) {
        return res.status(400).json({
          success: false,
          error: "Settlement ID is required.",
        });
      }

      const settlementRef = db
        .collection("bank_settlements")
        .doc(settlementId);

      const payoutRef = db
        .collection("merchant_settlement_payouts")
        .doc(settlementId);

      const merchantResult =
        await db.runTransaction(async (transaction) => {
          const settlementSnap =
            await transaction.get(settlementRef);

          if (!settlementSnap.exists) {
            throw new Error("Merchant settlement was not found.");
          }

          const settlement = settlementSnap.data() ?? {};

          const settlementStatus = text(
            settlement.status ??
              settlement.settlementStatus,
          ).toLowerCase();

          if (settlementStatus === "completed") {
            return {
              alreadyCompleted: true,
              settlement,
            };
          }

          if (settlementStatus !== "approved") {
            throw new Error(
              `Settlement must be Approved before payout. Current status: ${settlement.status ?? settlement.settlementStatus ?? "unknown"}.`,
            );
          }

          const existingPayoutSnap =
            await transaction.get(payoutRef);

          if (existingPayoutSnap.exists) {
            const existingPayout =
              existingPayoutSnap.data() ?? {};

            const existingStatus = text(
              existingPayout.status,
            ).toUpperCase();

            if (
              existingStatus === "PAID" ||
              existingStatus === "PROCESSING"
            ) {
              return {
                existingPayout: true,
                payout: existingPayout,
                settlement,
              };
            }
          }

          const merchantId = text(
            settlement.merchantId,
          );

          if (!merchantId) {
            throw new Error(
              "Merchant ID is missing from settlement.",
            );
          }

          const merchantRef = db
            .collection("merchants")
            .doc(merchantId);

          const merchantSnap =
            await transaction.get(merchantRef);

          if (!merchantSnap.exists) {
            throw new Error(
              "Merchant account was not found.",
            );
          }

          const merchantData: DocumentData =
            merchantSnap.data() ?? {};

          const payoutAccountStatus = text(
            merchantData.payoutAccountStatus ??
              merchantData.settlementAccountStatus ??
              merchantData.bankAccountStatus ??
              "",
          ).toUpperCase();

          const payoutVerified =
            merchantData.payoutAccountVerified === true ||
            merchantData.settlementAccountVerified === true ||
            merchantData.bankAccountVerified === true ||
            ["VERIFIED", "APPROVED", "ACTIVE"].includes(
              payoutAccountStatus,
            );

          if (!payoutVerified) {
            throw new Error(
              "Merchant payout account must be VERIFIED before real payout.",
            );
          }

          const currency = normalizeCurrency(
            settlement.currency ??
              merchantData.currency ??
              "MWK",
          );

          if (currency !== "MWK") {
            throw new Error(
              "Live merchant payout is currently enabled only for MWK in this MobiFlex PayChangu integration.",
            );
          }

          const amount = money(
            settlement.amount ??
              settlement.settlementAmount ??
              0,
          );

          if (amount <= 0) {
            throw new Error(
              "Merchant settlement amount must be greater than zero.",
            );
          }

          const payoutMethod: string = text(
            req.body?.payoutMethod ??
              req.body?.method ??
              merchantData.payoutMethod ??
              merchantData.settlementMethod ??
              "bank_transfer",
          ).toLowerCase();

          const chargeId =
            createTransactionId("MFMSP");

          transaction.set(
            payoutRef,
            {
              payoutId: payoutRef.id,
              settlementId,
              merchantId,
              merchantUid:
                text(settlement.merchantUid) ||
                null,
              amount,
              currency,
              payoutMethod,
              chargeId,
              provider: "paychangu",
              status: "PROCESSING",
              requestedBy: adminUser.uid,
              requestedByEmail: adminUser.email,
              createdAt:
                FieldValue.serverTimestamp(),
              updatedAt:
                FieldValue.serverTimestamp(),
            },
            { merge: true },
          );

          transaction.set(
            settlementRef,
            {
              payoutId: payoutRef.id,
              payoutChargeId: chargeId,
              payoutStatus: "PROCESSING",
              settlementStatus: "PROCESSING",
              settlementExecution: "PAYCHANGU",
              processedAt:
                FieldValue.serverTimestamp(),
              updatedAt:
                FieldValue.serverTimestamp(),
            },
            { merge: true },
          );

          return {
            payoutId: payoutRef.id,
            chargeId,
            merchantId,
            merchantData,
            settlement,
            amount,
            currency,
            payoutMethod,
          };
        });

      if (merchantResult.alreadyCompleted) {
        return res.status(200).json({
          success: true,
          settlementId,
          status: "PAID",
          alreadyCompleted: true,
          message:
            "Merchant settlement has already been completed.",
        });
      }

      if (merchantResult.existingPayout) {
        return res.status(200).json({
          success: true,
          settlementId,
          payoutId:
            merchantResult.payout?.payoutId ??
            payoutRef.id,
          chargeId:
            merchantResult.payout?.chargeId ??
            merchantResult.payout?.providerChargeId ??
            null,
          status:
            merchantResult.payout?.status ??
            "PROCESSING",
          alreadySubmitted: true,
          message:
            "A merchant payout has already been submitted or is processing. No duplicate payout was created.",
        });
      }

      const amount: number = Number(merchantResult.amount ?? 0);
      const currency: string = String(merchantResult.currency ?? "MWK");
      const payoutMethod: string =
        String(merchantResult.payoutMethod ?? "bank_transfer");
      const merchantData: DocumentData =
        merchantResult.merchantData ?? {};

      const walletBalance =
        await getPayChanguWalletBalance(currency);

      if (
        walletBalance.environment &&
        walletBalance.environment.toLowerCase() !== "live"
      ) {
        throw new Error(
          `PayChangu wallet is not in live environment. Current environment: ${walletBalance.environment}.`,
        );
      }

      if (
        walletBalance.currency &&
        walletBalance.currency !== currency
      ) {
        throw new Error(
          `PayChangu wallet currency mismatch. Expected ${currency}, received ${walletBalance.currency}.`,
        );
      }

      if (walletBalance.mainBalance + 0.0001 < amount) {
        throw new Error(
          `Insufficient PayChangu main balance for merchant payout. Required: ${amount.toFixed(2)} ${currency}; available: ${walletBalance.mainBalance.toFixed(2)} ${currency}.`,
        );
      }

      let providerResult: any;

      if (
        payoutMethod === "mobile_money" ||
        payoutMethod === "mobilemoney" ||
        payoutMethod === "momo"
      ) {
        const operator = normalizeOperator(
          req.body?.operator ??
            merchantData.providerName,
        );

        if (!operator) {
          throw new Error(
            "Airtel or TNM operator is required for mobile-money merchant payout.",
          );
        }

        const operatorInfo =
          await resolvePayChanguOperator(operator);

        const mobile = cleanMalawiMobile(
          req.body?.mobile ??
            req.body?.phone ??
            merchantData.phoneNumber ??
            merchantData.payoutPhoneNumber,
        );

        if (!/^\+265[89][0-9]{7,8}$/.test(mobile)) {
          throw new Error(
            "A valid Malawi mobile-money number is required for merchant payout.",
          );
        }

        providerResult =
          await payChanguRequest(
            "/mobile-money/payouts/initialize",
            {
              method: "POST",
              body: {
                mobile,
                mobile_money_operator_ref_id:
                  operatorInfo.refId,
                amount: amount.toFixed(2),
                charge_id:
                  merchantResult.chargeId,
                ...(text(req.body?.email)
                  ? {
                      email: text(
                        req.body.email,
                      ),
                    }
                  : {}),
                first_name: firstName(
                  text(
                    merchantData.accountName ??
                      merchantData.name ??
                      merchantData.businessName ??
                      "MobiFlex Merchant",
                  ),
                ),
                last_name: lastName(
                  text(
                    merchantData.accountName ??
                      merchantData.name ??
                      merchantData.businessName ??
                      "MobiFlex Merchant",
                  ),
                ),
              },
            },
          );
      } else if (
        payoutMethod === "bank" ||
        payoutMethod === "bank_transfer" ||
        payoutMethod === "banktransfer"
      ) {
        const bankUuid = text(
          req.body?.bankUuid ??
            req.body?.bank_uuid ??
            merchantData.bankUuid ??
            merchantData.payoutBankUuid,
        );

        const accountName = text(
          req.body?.bankAccountName ??
            req.body?.bank_account_name ??
            merchantData.accountName ??
            merchantData.payoutAccountName ??
            merchantData.businessName ??
            "MobiFlex Merchant",
        );

        const accountNumber = text(
          req.body?.bankAccountNumber ??
            req.body?.bank_account_number ??
            merchantData.accountNumber ??
            merchantData.payoutAccountNumber,
        );

        if (!bankUuid) {
          throw new Error(
            "bankUuid is required for merchant bank-transfer payout.",
          );
        }

        if (!accountName) {
          throw new Error(
            "Merchant bank account name is required.",
          );
        }

        if (!accountNumber) {
          throw new Error(
            "Merchant bank account number is required.",
          );
        }

        providerResult =
          await payChanguRequest(
            "/direct-charge/payouts/initialize",
            {
              method: "POST",
              body: {
                payout_method: "bank_transfer",
                bank_uuid: bankUuid,
                amount: amount.toFixed(2),
                charge_id:
                  merchantResult.chargeId,
                bank_account_name:
                  accountName,
                bank_account_number:
                  accountNumber,
                ...(text(req.body?.email)
                  ? {
                      email: text(
                        req.body.email,
                      ),
                    }
                  : {}),
                first_name:
                  firstName(accountName),
                last_name:
                  lastName(accountName),
              },
            },
          );
      } else {
        throw new Error(
          "Unsupported payout method. Use mobile_money or bank_transfer.",
        );
      }

      if (!providerResult.response.ok) {
        throw new Error(
          `PayChangu merchant payout initialization failed with HTTP ${providerResult.response.status}: ${safeJson(providerResult.data)}`,
        );
      }

      const providerCharge =
        providerChargeId(providerResult.data) ||
        merchantResult.chargeId;

      const providerStatus =
        payrollPayoutStatus(providerResult.data);

      await payoutRef.set(
        {
          provider: "paychangu",
          providerChargeId: providerCharge,
          providerStatus:
            providerStatus || "pending",
          providerResponse:
            providerResult.data,
          status: "PROCESSING",
          paidAt: null,
          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      await settlementRef.set(
        {
          payoutId: payoutRef.id,
          payoutChargeId: providerCharge,
          payoutStatus: "PROCESSING",
          settlementStatus: "PROCESSING",
          payoutProvider: "paychangu",
          payoutProviderStatus:
            providerStatus || "pending",
          updatedAt:
            FieldValue.serverTimestamp(),
        },
        { merge: true },
      );

      return res.status(200).json({
        success: true,
        settlementId,
        payoutId: payoutRef.id,
        chargeId: providerCharge,
        amount,
        currency,
        payoutMethod,
        status: "PROCESSING",
        providerStatus:
          providerStatus || "pending",
        message:
          "Real PayChangu merchant payout submitted. Provider verification is required before the settlement is marked PAID.",
      });
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : String(error);

      return res.status(500).json({
        success: false,
        error: message,
      });
    }
  },
);

// ============================================================
// MERCHANT - SUPER ADMIN REAL PAYOUT VERIFICATION
// ============================================================

app.get(
  "/admin/merchant-settlements/:settlementId/payout/verify",
  async (req: Request, res: Response) => {
    try {
      await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      assertPayChanguConfigured();

      const settlementId =
        text(req.params.settlementId);

      const settlementRef = db
        .collection("bank_settlements")
        .doc(settlementId);

      const payoutRef = db
        .collection("merchant_settlement_payouts")
        .doc(settlementId);

      const settlementSnap =
        await settlementRef.get();

      if (!settlementSnap.exists) {
        return res.status(404).json({
          success: false,
          error: "Merchant settlement was not found.",
        });
      }

      const settlement =
        settlementSnap.data() ?? {};

      const payoutSnap =
        await payoutRef.get();

      if (!payoutSnap.exists) {
        return res.status(404).json({
          success: false,
          error:
            "Merchant payout transaction record was not found.",
        });
      }

      const payout =
        payoutSnap.data() ?? {};

      const chargeId = text(
        payout.providerChargeId ??
          payout.chargeId ??
          settlement.payoutChargeId,
      );

      if (!chargeId) {
        return res.status(409).json({
          success: false,
          verified: false,
          error:
            "Provider charge ID is missing from the merchant payout.",
        });
      }

      const providerResult =
        await payChanguRequest(
          `/direct-charge/payouts/${encodeURIComponent(chargeId)}/details`,
          {
            method: "GET",
          },
        );

      if (!providerResult.response.ok) {
        return res.status(502).json({
          success: false,
          verified: false,
          error:
            `PayChangu merchant payout verification failed with HTTP ${providerResult.response.status}: ` +
            safeJson(providerResult.data),
        });
      }

      const providerData =
        providerResult.data?.data?.transaction ??
        providerResult.data?.transaction ??
        providerResult.data?.data ??
        providerResult.data ??
        {};

      const providerStatusValue =
        text(providerData.status) ||
        text(providerResult.data?.status) ||
        "pending";

      const expectedAmount = money(
        payout.amount ??
          settlement.amount ??
          settlement.settlementAmount ??
          0,
      );

      const providerAmount = money(
        providerData.amount,
      );

      const expectedCurrency =
        normalizeCurrency(
          payout.currency ??
            settlement.currency ??
            "MWK",
        );

      const providerCurrency =
        normalizeCurrency(
          providerData.currency ??
            expectedCurrency,
        );

      if (
        providerAmount > 0 &&
        Math.abs(
          providerAmount -
            expectedAmount,
        ) > 0.0001
      ) {
        await payoutRef.set(
          {
            status: "FAILED",
            providerStatus:
              providerStatusValue,
            verificationError:
              "Provider amount does not match merchant settlement amount.",
            providerVerificationResponse:
              providerResult.data,
            providerVerifiedAt:
              FieldValue.serverTimestamp(),
            updatedAt:
              FieldValue.serverTimestamp(),
          },
          { merge: true },
        );

        return res.status(409).json({
          success: false,
          verified: false,
          payoutStatus: "FAILED",
          error:
            "Provider amount does not match merchant settlement amount.",
        });
      }

      if (
        providerCurrency &&
        expectedCurrency !==
          providerCurrency
      ) {
        await payoutRef.set(
          {
            status: "FAILED",
            providerStatus:
              providerStatusValue,
            verificationError:
              "Provider currency does not match merchant settlement currency.",
            providerVerificationResponse:
              providerResult.data,
            providerVerifiedAt:
              FieldValue.serverTimestamp(),
            updatedAt:
              FieldValue.serverTimestamp(),
          },
          { merge: true },
        );

        return res.status(409).json({
          success: false,
          verified: false,
          payoutStatus: "FAILED",
          error:
            "Provider currency does not match merchant settlement currency.",
        });
      }

      const providerSucceeded =
        isSuccess(providerStatusValue);

      const providerFailed =
        isFailed(providerStatusValue);

      const nextStatus =
        providerSucceeded
          ? "PAID"
          : providerFailed
            ? "FAILED"
            : "PROCESSING";

      if (!providerSucceeded &&
          !providerFailed) {
        await payoutRef.set(
          {
            status: "PROCESSING",
            providerStatus:
              providerStatusValue,
            providerVerificationResponse:
              providerResult.data,
            providerVerifiedAt:
              FieldValue.serverTimestamp(),
            updatedAt:
              FieldValue.serverTimestamp(),
          },
          { merge: true },
        );

        await settlementRef.set(
          {
            payoutStatus: "PROCESSING",
            settlementStatus: "PROCESSING",
            payoutProviderStatus:
              providerStatusValue,
            updatedAt:
              FieldValue.serverTimestamp(),
          },
          { merge: true },
        );

        return res.status(200).json({
          success: true,
          verified: false,
          payoutStatus: "PROCESSING",
          providerStatus:
            providerStatusValue,
          message:
            "PayChangu has not reported a final payout status yet.",
        });
      }

      const merchantId = text(
        settlement.merchantId,
      );

      if (!merchantId) {
        return res.status(409).json({
          success: false,
          verified: false,
          error:
            "Merchant ID is missing from settlement.",
        });
      }

      const merchantRef = db
        .collection("merchants")
        .doc(merchantId);

      let ledgerAlreadyFinal = false;

      await db.runTransaction(
        async (transaction) => {
          const freshSettlementSnap =
            await transaction.get(
              settlementRef,
            );

          const freshPayoutSnap =
            await transaction.get(
              payoutRef,
            );

          const freshMerchantSnap =
            await transaction.get(
              merchantRef,
            );

          if (!freshMerchantSnap.exists) {
            throw new Error(
              "Merchant account was not found.",
            );
          }

          const freshSettlement =
            freshSettlementSnap.data() ?? {};

          const freshPayout =
            freshPayoutSnap.data() ?? {};

          const currentSettlementStatus =
            text(
              freshSettlement.settlementStatus ??
                freshSettlement.status,
            ).toLowerCase();

          const currentPayoutStatus =
            text(
              freshPayout.status,
            ).toUpperCase();

          if (
            currentSettlementStatus ===
              "completed" ||
            currentPayoutStatus === "PAID"
          ) {
            ledgerAlreadyFinal = true;
            return;
          }

          const merchantData: DocumentData =
            freshMerchantSnap.data() ?? {};

          const currentReserved =
            money(
              merchantData.reservedBalance ??
                merchantData.merchantReservedBalance ??
                0,
            );

          const currentAvailable =
            money(
              merchantData.availableBalance ??
                merchantData.merchantAvailableBalance ??
                0,
            );

          const currentSettled =
            money(
              merchantData.settledBalance ??
                merchantData.merchantSettledBalance ??
                0,
            );

          const currentWithdrawn =
            money(
              merchantData.withdrawnBalance ??
                merchantData.merchantWithdrawnBalance ??
                0,
            );

          const amountToRelease =
            money(
              freshPayout.amount ??
                freshSettlement.amount ??
                freshSettlement.settlementAmount ??
                0,
            );

          if (providerSucceeded) {
            transaction.update(
              merchantRef,
              {
                reservedBalance:
                  Math.max(
                    0,
                    currentReserved -
                      amountToRelease,
                  ),
                merchantReservedBalance:
                  Math.max(
                    0,
                    currentReserved -
                      amountToRelease,
                  ),
                settledBalance:
                  currentSettled +
                  amountToRelease,
                merchantSettledBalance:
                  currentSettled +
                  amountToRelease,
                withdrawnBalance:
                  currentWithdrawn +
                  amountToRelease,
                merchantWithdrawnBalance:
                  currentWithdrawn +
                  amountToRelease,
                lastSettlementCompletedId:
                  settlementId,
                lastSettlementCompletedAt:
                  FieldValue.serverTimestamp(),
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
            );

            transaction.set(
              payoutRef,
              {
                status: "PAID",
                providerStatus:
                  providerStatusValue,
                providerVerificationResponse:
                  providerResult.data,
                providerVerifiedAt:
                  FieldValue.serverTimestamp(),
                paidAt:
                  FieldValue.serverTimestamp(),
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
              { merge: true },
            );

            transaction.set(
              settlementRef,
              {
                status: "Completed",
                settlementStatus: "Completed",
                payoutStatus: "PAID",
                payoutProvider: "paychangu",
                payoutProviderStatus:
                  providerStatusValue,
                completedAt:
                  FieldValue.serverTimestamp(),
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
              { merge: true },
            );
          } else {
            transaction.update(
              merchantRef,
              {
                availableBalance:
                  currentAvailable +
                  amountToRelease,
                merchantAvailableBalance:
                  currentAvailable +
                  amountToRelease,
                reservedBalance:
                  Math.max(
                    0,
                    currentReserved -
                      amountToRelease,
                  ),
                merchantReservedBalance:
                  Math.max(
                    0,
                    currentReserved -
                      amountToRelease,
                  ),
                lastSettlementFailedId:
                  settlementId,
                lastSettlementFailedAt:
                  FieldValue.serverTimestamp(),
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
            );

            transaction.set(
              payoutRef,
              {
                status: "FAILED",
                providerStatus:
                  providerStatusValue,
                failureReason:
                  text(
                    providerData.message,
                  ) ||
                  text(
                    providerResult.data?.message,
                  ) ||
                  "Provider reported merchant payout failure.",
                providerVerificationResponse:
                  providerResult.data,
                providerVerifiedAt:
                  FieldValue.serverTimestamp(),
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
              { merge: true },
            );

            transaction.set(
              settlementRef,
              {
                status: "Failed",
                settlementStatus: "Failed",
                payoutStatus: "FAILED",
                payoutProvider: "paychangu",
                payoutProviderStatus:
                  providerStatusValue,
                rejectionReason:
                  text(
                    providerData.message,
                  ) ||
                  text(
                    providerResult.data?.message,
                  ) ||
                  "Provider reported merchant payout failure.",
                updatedAt:
                  FieldValue.serverTimestamp(),
              },
              { merge: true },
            );
          }
        },
      );

      return res.status(200).json({
        success: true,
        verified: true,
        alreadyFinal: ledgerAlreadyFinal,
        settlementId,
        payoutId: payoutRef.id,
        chargeId,
        payoutStatus: nextStatus,
        providerStatus:
          providerStatusValue,
        message: providerSucceeded
          ? "Merchant payout verified as PAID and merchant ledger settled."
          : "Merchant payout verified as FAILED and reserved funds released.",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);


// BANK SETTLEMENT - CONTROLLED
// ============================================================

app.post(
  "/settlements/bank/request",
  async (req: Request, res: Response) => {
    try {
      const staff = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
        "finance",
      ]);

      const amount = money(req.body?.amount);
      if (amount <= 0) {
        return res.status(400).json({
          success: false,
          error: "Settlement amount must be greater than zero.",
        });
      }

      const ref = db.collection("bank_settlements").doc();
      await ref.set({
        settlementId: ref.id,
        amount,
        currency: normalizeCurrency(req.body?.currency || "MWK"),
        bankName: text(req.body?.bankName),
        bankAccountName: text(req.body?.bankAccountName),
        bankAccountNumber: text(req.body?.bankAccountNumber),
        bankUuid: text(req.body?.bankUuid) || null,
        notes: text(req.body?.notes) || null,
        status: "Pending Approval",
        requestedByUid: staff.uid,
        requestedByEmail: staff.email,
        createdAt: FieldValue.serverTimestamp(),
        updatedAt: FieldValue.serverTimestamp(),
      });

      return res.status(201).json({
        success: true,
        settlementId: ref.id,
        status: "Pending Approval",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

app.post(
  "/settlements/bank/:settlementId/approve",
  async (req: Request, res: Response) => {
    try {
      const adminUser = await verifyStaff(req, [
        "super admin",
        "superadmin",
        "super administrator",
      ]);

      const settlementId = text(req.params.settlementId);

      const ref = db
        .collection("bank_settlements")
        .doc(settlementId);

      const snap = await ref.get();

      if (!snap.exists) {
        return res.status(404).json({
          success: false,
          error: "Settlement not found.",
        });
      }

      const settlementData = snap.data() ?? {};

      if (
        text(settlementData.status).toLowerCase() ===
        "approved"
      ) {
        return res.status(200).json({
          success: true,
          settlementId,
          status: "Approved",
          settlementStatus: "Approved",
          alreadyApproved: true,
        });
      }

      const settlementStatus = text(
        settlementData.status ??
          settlementData.settlementStatus,
      ).toLowerCase();

      if (settlementStatus !== "pending approval") {
        return res.status(409).json({
          success: false,
          error:
            "Only a Pending Approval settlement can be approved.",
          settlementId,
          status:
            settlementData.status ??
            settlementData.settlementStatus ??
            null,
        });
      }

      const approvalNow =
        FieldValue.serverTimestamp();

      await ref.set(
        {
          status: "Approved",
          settlementStatus: "Approved",
          approvedBy: adminUser.uid,
          approvedByUid: adminUser.uid,
          approvedByEmail: adminUser.email,
          approvedAt: approvalNow,
          settlementExecution: "CONTROLLED",
          updatedAt: approvalNow,
        },
        { merge: true },
      );

      return res.status(200).json({
        success: true,
        settlementId,
        status: "Approved",
        settlementStatus: "Approved",
        message:
          "Settlement approved. Actual bank transfer execution remains a separate controlled step.",
      });
    } catch (error) {
      return res.status(500).json({
        success: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      });
    }
  },
);

app.get(
  "/settlements/banks",
