      await db
        .collection("users")
        .doc(agentUid)
        .set({
          uid: agentUid,
          role: "Agent",
          agentType: "ANDROID_DEVICE_AGENT",
          accountStatus: "active",
          status: "active",
          country: text(req.body?.country || "Malawi"),
          deviceId,
          enrollmentId,
          merchantId: text(req.body?.merchantId) || null,
          applicationId: text(req.body?.applicationId) || null,
          managementMode: "MOBIFLEX_MANAGED",
          createdBy: superAdmin.uid,
          createdAt: FieldValue.serverTimestamp(),
          updatedAt: FieldValue.serverTimestamp(),
        });

      if (text(req.body?.applicationId)) {
        await db
          .collection("applications")
