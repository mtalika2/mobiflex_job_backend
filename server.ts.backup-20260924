      await enrollmentRef.set({
        enrollmentId,
        deviceId,
        agentUid,
        status: "pending",
        country: text(req.body?.country || "Malawi"),
        merchantId: text(req.body?.merchantId) || null,
        applicationId: text(req.body?.applicationId) || null,
        secretHash,
        authAttempts: 0,
        maxAuthAttempts: 5,
        expiresAt,
        createdBy: superAdmin.uid,
        createdByEmail: superAdmin.email,
        agentType: "ANDROID_DEVICE_AGENT",
        managementMode: "MOBIFLEX_MANAGED",
        notes: text(req.body?.notes) || null,
